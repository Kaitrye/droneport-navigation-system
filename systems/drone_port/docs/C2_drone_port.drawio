        <mxCell id="sNyU4pJd2-vfMVq4sT4E-25" parent="sNyU4pJd2-vfMVq4sT4E-30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6464;strokeColor=#FF6464;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Инфопанель&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;hr&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;общесистемный журнал,&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;мониторинг событий&lt;/font&gt;&lt;/div&gt;" vertex="1">
